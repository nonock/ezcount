{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ezcount",
  "version": "0.1.0",
  "identifier": "com.ezvany.ezcount",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ezcount",
        "width": 800,
        "height": 600,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["ezcount"] },
      "mobile": [
        { "scheme": ["ezcount"], "host": "join", "appLink": false },
        {
          "scheme": ["https"],
          "host": "ezcount-relay.fly.dev",
          "pathPrefix": ["/join"],
          "appLink": true
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
