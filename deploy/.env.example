# Public domain of the relay. Its DNS record must point at this server.
EZCOUNT_DOMAIN=ezcount.example.com

# Stored data in all, in MB (default 1024). Keep it under the disk space you give the relay.
# EZCOUNT_MAX_STORAGE_MB=1024

# How people reach you about the relay (an e-mail address or a page's address), shown on its
# /privacy and /delete-account pages.
# EZCOUNT_CONTACT=you@example.com

# The oldest version of the app the relay answers (like 0.5.0): older ones are told to update.
# EZCOUNT_MIN_APP_VERSION=
